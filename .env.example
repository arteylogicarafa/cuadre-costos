# Copia este archivo a .env y completa los valores. .env nunca se sube a git.
# Con la CLI de Neon: `neon init` y `neon env pull` escriben DATABASE_URL y DATABASE_URL_UNPOOLED por ti.

# Neon: cadena CON pool (el host termina en -pooler). La usa la aplicación.
DATABASE_URL="postgresql://USUARIO:CLAVE@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Neon: cadena directa, SIN pool. Solo la usan las migraciones.
DATABASE_URL_UNPOOLED="postgresql://USUARIO:CLAVE@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Clave para firmar las sesiones: texto largo y aleatorio (mínimo 32 caracteres).
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
